# ============================================================
# Customer Reporting System (CRS) - Environment Configuration
# ============================================================

# Database connection URL (Default: SQLite local database)
DATABASE_URL="file:./prisma/dev.db"

# Mandatory JWT secret for cryptographically signing session cookies.
# Generate a strong 32+ character random string (e.g., using `openssl rand -hex 32`)
AUTH_SECRET="replace-with-a-secure-random-32-byte-hex-secret-in-production"

# Secret token required to trigger automated cron kickoff jobs (/api/schedule/kickoff)
CRON_SECRET="replace-with-a-secure-random-token-for-cron-triggers"

# Initial password for the seeded administrator account on first boot (username: admin)
DEFAULT_ADMIN_PASSWORD="change-this-initial-admin-password-immediately"

# Set to "true" when serving over HTTPS/SSL to enforce Secure cookie flags
SECURE_COOKIES="true"

# Application runtime environment and network port
NODE_ENV="production"
PORT=3000

# Optional: Path to custom Chromium/Chrome executable for Puppeteer PDF rendering
# (Leave blank to use system auto-detected Google Chrome or Microsoft Edge)
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/google-chrome-stable"
