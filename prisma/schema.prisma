generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Customer {
  id                String   @id @default(cuid())
  customerName      String
  customerId        String
  serviceId         String
  serviceName       String   @default("Prime 300 Mbps")
  nodeCount         Int      @default(1)
  targetSla         Float    @default(99.5)
  graphType         String   @default("MRTG") // Preferred engine: "MRTG" or "PRTG"
  graphId           String?  // Legacy/fallback graph ID
  cactiGraphId      String?  // Cacti Graph ID
  prtgSensorId      String?  // PRTG Sensor ID
  trafficDirection  String   @default("NORMAL") // "NORMAL" or "REVERSED"
  isMonthlyRoutine  Boolean  @default(false)    // Enrolled in monthly routine schedule
  routineGroup      String   @default("Customer Experience") // NOC classified: "Customer Experience", "Account Executive", "Finance"
  routineReportType String   @default("SLA")    // "SLA", "MRTG", or "BOTH"
  salesPicId        String?  // Linked StaffMember ID for Account Executive / Sales
  salesPicName      String?  // Name of Sales PIC
  cePicId           String?  // Linked StaffMember ID for Customer Experience
  cePicName         String?  // Name of CE PIC
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isMonthlyRoutine])
  @@index([routineGroup])
  @@index([salesPicId])
  @@index([cePicId])
}

model Report {
  id                   String   @id @default(cuid())
  reportType           String   // "MRTG" or "SLA"
  graphType            String   @default("MRTG") // "MRTG" or "PRTG"
  documentNumber       String   @unique
  customerName         String
  customerId           String
  serviceId            String
  serviceName          String   @default("Prime 300 Mbps")
  nodeCount            Int      @default(1)
  targetSla            Float    @default(99.5)
  reportPeriod         String   // e.g. "October 2026"
  periodMonth          Int
  periodYear           Int
  graphId              String?  // Active Graph or Sensor ID used
  cactiGraphId         String?  // Cacti Graph ID
  prtgSensorId         String?  // PRTG Sensor ID
  graphImage           String?  // Base64 data URL
  dlAvg                Float?
  dlMax                Float?
  ulAvg                Float?
  ulMax                Float?
  dlUnit               String   @default("Mbps")
  ulUnit               String   @default("Mbps")
  trafficDirection     String   @default("NORMAL") // "NORMAL" or "REVERSED"
  onlinePercent        Float?   @default(100.0)
  downtimePercent      Float?   @default(0.0)
  availabilityPercent  Float?   @default(100.0)
  totalDowntimeMinutes Int?     @default(0)
  downtimeDurationStr  String?  @default("-")
  tickets              String?  // JSON string
  cases                String?  // JSON string
  pdfPath              String?
  // Two-tier approval lifecycle: PENDING_NOC_APPROVAL -> PENDING_DEPT_APPROVAL -> APPROVED, REVISION_NEEDED
  status               String   @default("PENDING_NOC_APPROVAL")
  assignedDepartment   String   @default("Customer Experience") // "Customer Experience", "Account Executive", "Finance"
  generatedById        String?
  generatedByName      String?
  
  // Tier 1: Technical Approval by NOC Supervisor
  nocApprovedById      String?
  nocApprovedByName    String?
  nocApprovedAt        DateTime?
  
  // Tier 2: Departmental Approval by CX / AE / Finance Supervisor
  deptApprovedById     String?
  deptApprovedByName   String?
  deptApprovedAt       DateTime?

  // Legacy fallback fields for backward compatibility
  approvedById         String?
  approvedByName       String?
  approvedAt           DateTime?
  
  rejectionNotes       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status])
  @@index([assignedDepartment])
}

model DiscoveredItem {
  id             String   @id @default(cuid())
  engine         String   // "MRTG" atau "PRTG"
  groupName      String?  // Probe / Group / Site / Tree
  subGroupName   String?  // Sub-Group (PRTG nested groups)
  deviceName     String   // Nama Switch / Router / Host
  deviceIp       String?  // IP Address perangkat
  interfaceName  String   // Nama Port / Sensor
  fullTitle      String   // Judul lengkap dari monitoring
  targetId       String   // local_graph_id (Cacti) atau objid (PRTG)
  detectedSid    String?  // Service ID hasil ekstraksi dari judul
  detectedCid    String?  // Customer ID hasil ekstraksi
  status         String   @default("Up") // Up / Down / Unknown / Paused
  lastDiscovered DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([engine])
  @@index([targetId])
  @@index([detectedSid])
  @@index([deviceName])
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  name         String
  email        String?   @unique
  passwordHash String
  passwordSalt String
  role         String    @default("OPERATOR") // "ADMIN", "SUPERVISOR", "STAFF", "OPERATOR", "VIEWER"
  department   String    @default("Network Operation") // "Network Operation", "Customer Experience", "Account Executive", "Finance"
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([username])
  @@index([role])
  @@index([department])
}

model AppConfig {
  id                           String   @id @default("default")
  mrtgBaseUrl                  String   @default("http://cacti.internal.net")
  mrtgUsername                 String   @default("")
  mrtgPassword                 String   @default("")
  mrtgAuthType                 String   @default("BASIC") // "BASIC" or "COOKIE"
  prtgBaseUrl                  String   @default("http://prtg.internal.net")
  prtgUsername                 String   @default("")
  prtgPassword                 String   @default("")
  prtgAuthType                 String   @default("PASSWORD") // "PASSWORD" or "PASSHASH"
  prtgBasicUsername            String?  @default("appsmg01")
  prtgBasicPassword            String?  @default("appsmg01")
  coverMrtgPath                String   @default("/assets/templates/cover_mrtg.png")
  coverSlaPath                 String   @default("/assets/templates/cover_sla.png")
  pageBgPath                   String   @default("/assets/templates/page_bg.png")
  defaultTargetSla             Float    @default(99.5)
  documentNumberPrefix         String   @default("IMUN.01")
  telegramBotToken             String   @default("")
  telegramChatId               String   @default("")
  telegramThreadId             String   @default("") // Topic ID / message_thread_id
  telegramNotificationsEnabled Boolean  @default(false)
  
  // Email (SMTP) Integration
  emailNotificationsEnabled    Boolean  @default(false)
  smtpHost                     String   @default("")
  smtpPort                     Int      @default(587)
  smtpSecure                   Boolean  @default(false)
  smtpUser                     String   @default("")
  smtpPassword                 String   @default("")
  smtpFromEmail                String   @default("noreply-genre@nexa.net.id")
  smtpFromName                 String   @default("NEXA GENRE Reporting")
  
  // Department Email Mappings (Distribution Lists)
  emailDeptSales               String   @default("sls@nexa.net.id")
  emailDeptCe                  String   @default("cxe@nexa.net.id")
  emailDeptFinance             String   @default("finc@nexa.net.id")
  emailDeptHelpdesk            String   @default("helpdesk@nexa.net.id")
  
  // Custom Notification Templates
  emailTemplateRequestReceived String?
  emailTemplateApprovalNeeded  String?
  emailTemplateReportApproved  String?
  telegramTemplateRequestReceived String?
  telegramTemplateApprovalNeeded  String?
  
  updatedAt                    DateTime @updatedAt
}

model StaffMember {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  department  String   // "Customer Experience", "Account Executive", "Finance", "Network Operation"
  roleTitle   String?  // e.g. "Account Manager", "Customer Experience Specialist"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([department])
  @@index([isActive])
}

model ReportRequest {
  id                String    @id @default(cuid())
  ticketNumber      String    @unique // e.g. REQ-202611-0001
  requesterUserId   String?   // Linked User account ID if authenticated
  requesterName     String
  requesterEmail    String?
  requesterDept     String    // "Network Operation", "Customer Experience", "Account Executive", "Finance"
  salesPicName      String?   // Sales / Account Executive PIC Name
  salesPicEmail     String?   // Sales / Account Executive PIC Email
  cePicName         String?   // Customer Experience PIC Name
  cePicEmail        String?   // Customer Experience PIC Email
  reportType        String    // "SLA", "MRTG", "BOTH"
  customerName      String
  customerId        String?
  serviceId         String?
  periodMonth       Int
  periodYear        Int
  periodsJson       String?   // JSON Array for multi-month requests e.g. [{"month":8,"year":2026},{"month":9,"year":2026}]
  urgency           String    @default("NORMAL") // "NORMAL" or "URGENT"
  notes             String?
  status            String    @default("PENDING") // "PENDING", "IN_PROGRESS", "SCHEDULED_ROUTINE", "COMPLETED", "CANCELLED"
  emailThreadMessageId String? // RFC 2822 Message-ID for thread chaining e.g. <REQ-202611-0001@genre.nexa.net.id>
  processedById         String?
  processedByName       String?
  processedReportId     String?
  processedMrtgReportId String?
  processedSlaReportId  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([ticketNumber])
  @@index([customerName])
  @@index([requesterDept])
  @@index([requesterUserId])
  @@index([createdAt])
}

model MonthlyScheduleTask {
  id                   String    @id @default(cuid())
  customerId           String
  customerName         String
  serviceId            String?
  serviceName          String?
  periodMonth          Int
  periodYear           Int
  reportType           String    @default("SLA") // "SLA", "MRTG", "BOTH"
  assignedDepartment   String    @default("Customer Experience") // "Customer Experience", "Account Executive", "Finance"
  executionType        String    @default("MANUAL") // "AUTO_SCHEDULED" or "MANUAL"
  errorMessage         String?
  kickoffTime          DateTime  @default(now())
  deadlineTime         DateTime  // 24 hours from kickoff
  status               String    @default("PENDING") // "PENDING", "COMPLETED", "FAILED_MANUAL_REQUIRED", "BREACHED"
  completedAt          DateTime?
  completedReportId    String?
  processedByName      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([periodMonth, periodYear])
  @@index([assignedDepartment])
  @@index([reportType])
  @@index([status])
  @@index([customerName])
  @@index([deadlineTime])
}
